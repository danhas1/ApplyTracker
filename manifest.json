{
  "manifest_version": 3,
  "name": "ApplyTracker",
  "version": "1.0",
  "description": "Track your job applications directly from Chrome.",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ApplyTracker"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://localhost:3000 http://127.0.0.1:*;"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}